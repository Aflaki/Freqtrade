# Generate the three secrets with:  python -m app.cli genkeys
SECRET_KEY=
MASTER_KEY=
WEBHOOK_SECRET=

# Public address of this panel (used for the Freqtrade webhook URL shown in admin)
BASE_URL=https://panel.example.com
# true when served over HTTPS
SECURE_COOKIES=true

# SQLite by default; for production e.g. postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./data/relay.db

# Telegram bot from @BotFather (one bot for all users)
TELEGRAM_BOT_TOKEN=

# freqtrade | generic
SIGNAL_SOURCE=freqtrade
# fill = copy when Freqtrade's order filled (recommended) | order = as soon as Freqtrade places it
FREQTRADE_RELAY_ON=fill
# optional: only accept webhooks from these IPs (comma separated)
WEBHOOK_ALLOWED_IPS=
DEDUPE_SECONDS=30
